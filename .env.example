APP_NAME=litigation-case-agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://litigation_agent:litigation_agent_dev@127.0.0.1:5432/litigation_case_agent
TEST_DATABASE_URL=postgresql+psycopg://litigation_agent:litigation_agent_dev@127.0.0.1:5432/litigation_case_agent_test

# Real LLM — use deterministic for offline/tests
LLM_MODE=real
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=你的新DeepSeek_API_Key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# CamScanner CLI — 扫描 PDF → Markdown
# Docs: https://www.camscanner.com/agent-docs/zh/platforms/for-agents/cli/
# 首次需本机执行: npx camscanner-cli auth login
CAMSCANNER_CLI_ENABLED=true
CAMSCANNER_CLI_COMMAND=
CAMSCANNER_CLI_CWD=
CAMSCANNER_CLI_TIMEOUT_SECONDS=300
CAMSCANNER_MAX_UPLOAD_BYTES=41943040
CAMSCANNER_TEMP_DIR=

# Autonomous dev orchestrator (Issue #2)
GITHUB_WEBHOOK_SECRET=
# Do NOT commit real tokens. Prefer Sealos Secret / DevBox env injection.
# GITHUB_TOKEN=           # fine-grained PAT (Option A)
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key
# GITHUB_SSH_KEY_PATH=~/.ssh/github_agent_deploy
# GITHUB_AUTH_MODE=auto     # auto | pat | app | ssh
GITHUB_REPO=yangqianwei8-sudo/agent
CURSOR_API_KEY=
CURSOR_MODEL=composer-2
AUTONOMOUS_DEV_ENABLED=true
AUTONOMOUS_WORKER_MODE=deterministic
AUTONOMOUS_REPO_ROOT=/home/devbox/project
AUTONOMOUS_STATE_DB_PATH=data/autonomous_dev.db
AUTONOMOUS_WEBHOOK_PUBLIC_URL=
WATCHDOG_INTERVAL_SECONDS=3600
