# Copy to .env and fill values locally. NEVER commit real secrets.

# Application
APP_HOST=0.0.0.0
APP_PORT=8000

# Autonomous development
AUTONOMOUS_DEV_ENABLED=false
AUTONOMOUS_WORKER_MODE=deterministic
AUTONOMOUS_REPO_ROOT=.
AUTONOMOUS_STATE_DB_PATH=data/autonomous_dev.db
GITHUB_REPO=yangqianwei8-sudo/agent
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
GITHUB_AUTH_MODE=auto
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_SSH_KEY_PATH=
GITHUB_TOKEN_FILE=
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
WEBHOOK_PUBLIC_URL=

# Independent reviewer
OPENAI_API_KEY=
REVIEWER_MODEL=gpt-4o-mini
REVIEWER_BASE_URL=https://api.openai.com/v1
REVIEWER_MAX_RETRIES=2
REVIEWER_LEASE_TTL_SECONDS=300
REVIEWER_STALL_SECONDS=60
REVIEWER_ORPHAN_LOCK_STALL_SECONDS=45
REVIEW_MAX_ATTEMPTS=5
REVIEW_RETRY_BACKOFF_SECONDS=5
REVIEW_RECOVERY_INTERVAL_SECONDS=10

# Watchdog / recovery
WATCHDOG_INTERVAL_SECONDS=3600
CURRENT_TASK_SCAN_INTERVAL_SECONDS=10
WATCHDOG_GITHUB_CONNECT_TIMEOUT_SECONDS=2
WATCHDOG_GITHUB_READ_TIMEOUT_SECONDS=5
WORKER_LEASE_TTL_SECONDS=300
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
REVIEW_WATCHDOG_STALE_SECONDS=3600
HANDOFF_STALL_SECONDS=20
AUTONOMOUS_PROGRESS_STALE_SECONDS=120
CURSOR_LONG_OP_GRACE_SECONDS=600
CURSOR_LONG_OP_SUSPECT_SECONDS=900

# External uvicorn supervisor health recovery
AUTONOMOUS_HEALTH_URL=http://127.0.0.1:8000/healthz
AUTONOMOUS_HEALTH_INTERVAL_SECONDS=10
AUTONOMOUS_HEALTH_FAILURE_LIMIT=3
AUTONOMOUS_STARTUP_GRACE_SECONDS=15

# Backend/runtime placeholders
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=redis://HOST:6379/0
SECRET_KEY=CHANGE_ME
